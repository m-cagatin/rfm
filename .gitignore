# Essential files to ignore

# Documentation files - ignore all markdown and text files
*.md
*.txt

# Dependencies
/node_modules
backend/node_modules
**/node_modules
npm-debug.log
yarn-error.log

# Build output
/dist
/tmp
/out-tsc

# Angular cache
/.angular/cache

# Environment variables (CRITICAL - contains sensitive credentials)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

